generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  passwordHash     String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  role             String    @default("USER")
  phone            String?   @unique
  resetToken       String?
  resetTokenExpiry DateTime?
  cityId           String?
  pincodes         String[]  @default([])
  managedCities    City[]    @relation("ZonalManager")
  
  // Hierarchical Management
  managerId        String?
  manager          User?     @relation("UserManagement", fields: [managerId], references: [id])
  managedUsers     User[]    @relation("UserManagement")

  // A partner's relationship manager (RELATIONSHIP_MANAGER), who routes the partner's orders
  relationshipManagerId String?
  relationshipManager   User?     @relation("PartnerRelationshipManager", fields: [relationshipManagerId], references: [id], onDelete: SetNull)
  rmPartners            User[]    @relation("PartnerRelationshipManager")

  orders           Order[]    @relation("OrderCustomer")
  partnerOrders    Order[]    @relation("OrderPartner")
  riders           Rider[]
  city             City?     @relation("UserCity", fields: [cityId], references: [id])
}

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive     Boolean  @default(true)
  pincodes     String[] @default([])
  displayOrder Int      @default(0)
  isFeatured   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  managerId String?
  manager   User?    @relation("ZonalManager", fields: [managerId], references: [id])
  users     User[]   @relation("UserCity")
}

model Rider {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  status    String   @default("available")
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  partnerId String?
  orders    Order[]
  partner   User?    @relation(fields: [partnerId], references: [id])
}

model Order {
  id                 String   @id @default(cuid())
  userId             String
  riderId            String?
  device             String
  price              Int
  status             String   @default("Pending Pickup")
  address            String
  locationLat        Float?
  locationLng        Float?
  answers            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  orderNumber        Int      @unique @default(autoincrement())
  pincode            String?
  offeredPrice       Int?
  riderAnswers       String?
  verificationImages String[] @default([])
  // The partner the order is routed to (set from the pincode on creation; RMs and admins may reassign)
  partnerId          String?
  partner            User?    @relation("OrderPartner", fields: [partnerId], references: [id], onDelete: SetNull)
  rider              Rider?   @relation(fields: [riderId], references: [id])
  user               User     @relation("OrderCustomer", fields: [userId], references: [id], onDelete: Cascade)
}

model Brand {
  id         String   @id
  name       String
  logo       String
  categories String[] @default([])
  priority   Int      @default(100)
  models     Model[]
}

model Model {
  id       String    @id @default(cuid())
  brandId  String
  name     String
  img      String
  category String    @default("smartphone")
  priority Int       @default(100)
  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  variants Variant[]
}

model Variant {
  id        String @id @default(cuid())
  modelId   String
  name      String
  basePrice Int
  model     Model  @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model EvaluationRule {
  id               String   @id @default(cuid())
  category         String
  questionKey      String
  answerKey        String
  label            String
  deductionAmount  Int      @default(0)
  deductionPercent Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([category, questionKey, answerKey])
}

model EmailMessage {
  id         String   @id @default(cuid())
  messageId  String?  @unique
  from       String
  to         String
  subject    String?
  bodySnippet String?
  bodyText   String?
  bodyHtml   String?
  receivedAt DateTime @default(now())
  isOutbound Boolean  @default(false)
  status     String   @default("delivered")
  threadId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model EmailAccount {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DeviceDisplayPrice {
  id            String   @id @default(cuid())
  categoryKey   String   @unique // e.g., 'phones', 'tablets', 'laptops', 'watches', 'cameras'
  categoryName  String   // e.g., 'Smartphones'
  displayPrice  String   // e.g., '₹129k+'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// The Customer app's home-page carousel, edited in the Admin app ("Edit carousel view"); read and written only by
// the Spring Boot backend (CarouselService).
model CarouselSlide {
  id           String   @id @default(cuid())
  imageUrl     String   // a website path (/uploads/...) or https URL
  title        String
  subtitle     String   @default("")
  category     String?  // sell category the card opens (e.g. 'smartphone'); null = no tap
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// The screen guard shop (Customer app store, edited in the Admin app); read and written only by the Spring Boot
// backend (ShopService).
model ScreenGuard {
  id           String   @id @default(cuid())
  name         String
  guardType    String   // tempered | privacy | matte | clear | full | lens
  brand        String   // phone brand it fits, e.g. "Apple"
  model        String   // phone model it fits, e.g. "iPhone 15"
  imageUrl     String?  // a website path (/uploads/...) or https URL
  mrp          Int      // price before discount, whole rupees
  price        Int      // sale price, whole rupees (<= mrp)
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Switches set in the Admin app: shop.storeEnabled and shop.discountsEnabled ("true" | "false"; missing = on).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// A screen guard order, cash on delivery. items is JSON: [{screenGuardId, name, model, quantity, unitPrice, unitMrp}].
model ShopOrder {
  id            String   @id @default(cuid())
  orderNumber   Int      @unique @default(autoincrement())
  userId        String?
  items         String
  total         Int
  name          String
  phone         String
  address       String
  pincode       String
  paymentMethod String   @default("cod")
  status        String   @default("placed") // placed | confirmed | shipped | delivered | cancelled
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// A refurbished device for sale. grade: superb | good | fair. The order takes one from stock.
model RefurbishedDevice {
  id             String   @id @default(cuid())
  name           String
  brand          String
  storage        String
  grade          String
  warrantyMonths Int      @default(6)
  imageUrl       String?
  mrp            Int
  price          Int
  stock          Int      @default(1)
  isActive       Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// A refurbished device order, cash on delivery, with its own copy of what was bought.
model RefurbishedOrder {
  id             String   @id @default(cuid())
  orderNumber    Int      @unique @default(autoincrement())
  userId         String?
  deviceId       String
  deviceName     String
  storage        String
  grade          String
  warrantyMonths Int
  imageUrl       String?
  price          Int
  mrp            Int
  name           String
  phone          String
  address        String
  pincode        String
  paymentMethod  String   @default("cod")
  status         String   @default("placed") // placed | confirmed | shipped | delivered | cancelled
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// The fixed price of one repair for one phone. issue: screen | battery | charging | camera | speaker | back.
model RepairPrice {
  id           String   @id @default(cuid())
  brand        String
  model        String
  issue        String
  price        Int
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([brand, model, issue])
}

// A doorstep repair visit, paid after the repair, with its own copy of the price. slot: morning | afternoon | evening.
model RepairBooking {
  id            String   @id @default(cuid())
  bookingNumber Int      @unique @default(autoincrement())
  userId        String?
  repairPriceId String
  brand         String
  model         String
  issue         String
  price         Int
  visitDate     String
  slot          String
  name          String
  phone         String
  address       String
  pincode       String
  status        String   @default("booked") // booked | confirmed | completed | cancelled
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?  // Target user (if specific)
  role      String?  // Target role (for broadcasting e.g. ADMIN, ZONAL_HEAD)
  title     String
  message   String
  type      String   @default("info") // info, order_new, order_assigned
  orderId   String?
  riderId   String?  // Target rider (if specific)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
