{
  "expo": {
    "name": "Fonzkart",
    "slug": "fonzkart-customer",
    "scheme": "fonzkart",
    "version": "0.7.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "in.fonzkart.customer",
      "versionCode": 24,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-background.png",
        "backgroundColor": "#062615"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "in.fonzkart.customer",
      "supportsTablet": false,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fonzkart uses your location to fill in your pickup address and to guide the executive to your door."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 72,
          "resizeMode": "contain",
          "backgroundColor": "#f4f7f5",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#060a08"
          }
        }
      ],
      "expo-secure-store",
      "expo-status-bar"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7b9db415-f362-41eb-8722-dc720e8423fb"
      }
    },
    "owner": "hiten_verma"
  }
}
